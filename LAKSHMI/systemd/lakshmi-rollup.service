[Unit]
Description=Lakshmi telemetry rollup — aggregate completed windows into hourly rollups
Documentation=file://%h/Desktop/MANDALA_OS/LAKSHMI/README.md
After=network-online.target
Wants=edge-galaxy.service

[Service]
Type=oneshot
# Fleet v9.1.4: the telemetry galaxy lives in the home gateway store (18790).
ExecStart=/usr/bin/curl -sS -m 120 -X POST http://127.0.0.1:18790/mcp -H "Content-Type: application/json" -d "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"name\":\"telemetry.rollup\",\"arguments\":{}}}"
